# ClassGuard Backend — Environment Variables
# Copy this file to .env and fill in values:
#   cp .env.example .env

# REQUIRED — Django will crash without this.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-real-secret-key

# Set to False in production
DEBUG=True

# Comma-separated allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated CORS origins for the frontend dev server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis URL (used for Channels WebSocket layer and Celery task queue)
# Leave as-is if Redis is installed locally; remove or leave empty to use
# in-memory fallback (works for development, NOT for production)
REDIS_URL=redis://localhost:6379/0

# Twilio (OPTIONAL — for SMS/WhatsApp alert forwarding)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_PHONE_NUMBER=

# Database (OPTIONAL — defaults to SQLite for development)
# For PostgreSQL, set a connection URL like:
#   DATABASE_URL=postgres://user:password@localhost:5432/classguard
DATABASE_URL=
