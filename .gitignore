# Python
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
env/

# Environment variables (contain secrets — never commit)
# After cloning, copy .env.example to .env and fill in values
.env
.env.*
!.env.example

# Database (contains student records and face encodings)
# After cloning, run: python manage.py migrate
# To transfer data, use: python manage.py dumpdata / loaddata
*.sqlite3

# Media uploads (student photos, snapshots)
# After cloning, re-register student faces via the Face Registration page
# Or copy media/ from the main computer
backend/media/

# Static collected (auto-generated by collectstatic)
backend/staticfiles/

# Model weights (too large for git — download after cloning)
# YOLO: python -c "from ultralytics import YOLO; YOLO('yolov8n.pt')"
*.pt
*.onnx
*.engine

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node
node_modules/
dist/

# Pytest
.pytest_cache/
htmlcov/
.coverage

# SSL certificates
infra/nginx/ssl/*.pem
infra/nginx/ssl/*.key
infra/nginx/ssl/*.crt
